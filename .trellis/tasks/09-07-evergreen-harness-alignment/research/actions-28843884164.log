build	Comment PR	const countFiles = (dir) => {
build	Comment PR	  let count = 0;
build	Comment PR	  const files = fs.readdirSync(dir);
build	Comment PR	  for (const file of files) {
build	Comment PR	    const filePath = path.join(dir, file);
build	Comment PR	    if (fs.statSync(filePath).isDirectory()) {
build	Comment PR	      count += countFiles(filePath);
build	Comment PR	    } else {
build	Comment PR	      count++;
build	Comment PR	    }
build	Comment PR	  }
build	Comment PR	  return count;
build	Comment PR	};
