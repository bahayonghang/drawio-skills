{
  "name": "drawio-skills",
  "version": "2.8.0",
  "description": "A desktop-first Draw.io skill with YAML DSL, offline sidecars, and optional live browser editing.",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "node scripts/run-tests.js",
    "test:parsers": "node scripts/run-tests.js --code-parsers",
    "version:check": "node scripts/version-sync.js --check",
    "lint": "markdownlint \"docs/**/*.md\" \"skills/**/*.md\" \"README*.md\" --ignore \"skills/drawio/references/official/**\" --ignore \"skills/drawio/references/upstream/**\" --ignore \"skills/drawio/scripts/vendor/**\"",
    "ci": "npm run version:check && npm run lint && npm test && npm run test:parsers && npm run docs:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahayonghang/drawio-skills.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahayonghang/drawio-skills/issues"
  },
  "homepage": "https://github.com/bahayonghang/drawio-skills#readme",
  "devDependencies": {
    "markdownlint-cli": "^0.47.0",
    "prettier": "^3.8.1",
    "vitepress": "^1.6.4"
  },
  "optionalDependencies": {
    "es-module-lexer": "2.3.1",
    "tree-sitter": "0.21.1",
    "tree-sitter-go": "0.23.4",
    "tree-sitter-rust": "0.23.0"
  }
}
